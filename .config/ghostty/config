# Ghostty config - replicated from Kitty/Alacritty

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13
font-thicken = true

# Transparency
background-opacity = 0.93
background-blur = 20

# Window
window-decoration = none
macos-non-native-fullscreen = true

# Colors from Alacritty (Gruvbox custom)
background = #30302c
foreground = #e8e8d3
palette = 0=#151513
palette = 1=#d68787
palette = 2=#87af87
palette = 3=#d8af5f
palette = 4=#87afaf
palette = 5=#df5f87
palette = 6=#87d7d7
palette = 7=#808070
palette = 8=#4e4e43
palette = 9=#d68787
palette = 10=#87af87
palette = 11=#d8af5f
palette = 12=#87afaf
palette = 13=#df5f87
palette = 14=#87d7d7
palette = 15=#e8e8d3

# Cursor
cursor-style = block

# Scrollback
scrollback-limit = 10000

# Custom shader - blackhole
custom-shader = /Users/speedmaster/Concepts/exp-dotfiles/.config/ghostty/blackhole/blackhole.glsl
custom-shader-animation = true

# Keybindings - tmux (same as Kitty/Alacritty)
keybind = super+t=text:\x1bt
keybind = super+d=text:\x01|
keybind = super+shift+d=text:\x01"
keybind = super+left=text:\x1b\x1b[D
keybind = super+right=text:\x1b\x1b[C
